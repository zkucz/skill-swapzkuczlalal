<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SkillSwap</title>

  <style>

    /* =====================================================
       COLORS
       CHANGE THESE IF YOU WANT TO RECOLOR THE WHOLE APP
    ===================================================== */

    :root {
      --primary: #246BFD;
      --primary-dark: #1749B8;
      --primary-light: #E7EFFF;

      --secondary: #FFD84D;
      --secondary-dark: #B88A00;
      --secondary-light: #FFF6C7;

      --dark: #172554;
      --background: #F6F8FF;

      --white: #FFFFFF;
      --gray: #777777;
      --light-gray: #EEEEEE;
    }


    /* =====================================================
       GENERAL
    ===================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;

      background:
        linear-gradient(
          135deg,
          #E7EFFF,
          #FFF6C7
        );

      display: flex;
      justify-content: center;
      align-items: center;

      padding: 30px 0;
    }

    .app {
      width: 400px;
      min-height: 800px;

      background: white;

      border-radius: 30px;

      overflow: hidden;

      box-shadow:
        0 15px 45px
        rgba(0, 0, 0, 0.15);

      position: relative;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    header {
      height: 80px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 22px;

      border-bottom:
        1px solid var(--light-gray);
    }

    .logo {
      font-size: 27px;
      font-weight: bold;

      color: var(--primary);
    }

    .logo span {
      color: var(--secondary-dark);
    }

    .header-right {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .match-counter {
      font-size: 12px;

      background:
        var(--primary-light);

      color:
        var(--primary);

      padding:
        8px 10px;

      border-radius:
        20px;
    }

    .sessions-button {
      border: none;

      background:
        var(--secondary);

      color:
        var(--dark);

      padding:
        8px 10px;

      border-radius:
        20px;

      font-size:
        12px;

      cursor:
        pointer;

      font-weight:
        bold;
    }


    /* =====================================================
       YOUR SKILLS
    ===================================================== */

    .your-skills {
      padding:
        16px 22px 3px;
    }

    .your-skills h3 {
      font-size:
        13px;

      color:
        var(--gray);

      margin:
        7px 0;
    }

    .mini-tag {
      display:
        inline-block;

      background:
        #F1F3F8;

      padding:
        5px 9px;

      border-radius:
        12px;

      font-size:
        11px;

      margin:
        2px;
    }


    /* =====================================================
       PROFILE CARD
    ===================================================== */

    .card-area {
      padding:
        15px 20px;
    }

    .card {
      background:
        white;

      border-radius:
        25px;

      overflow:
        hidden;

      box-shadow:
        0 8px 30px
        rgba(0, 0, 0, 0.13);

      transition:
        transform 0.35s ease,
        opacity 0.35s ease;
    }

    .profile-image {
      height:
        250px;

      display:
        flex;

      justify-content:
        center;

      align-items:
        center;

      font-size:
        80px;

      color:
        white;

      font-weight:
        bold;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );
    }

    .profile-info {
      padding:
        20px;
    }

    .name-line {
      display:
        flex;

      justify-content:
        space-between;

      align-items:
        center;

      gap:
        10px;
    }

    .name-line h2 {
      font-size:
        23px;
    }

    .match-score {
      background:
        #E7FFF0;

      color:
        #0B9C50;

      font-weight:
        bold;

      padding:
        6px 10px;

      border-radius:
        15px;

      font-size:
        12px;

      white-space:
        nowrap;
    }

    .university {
      color:
        var(--gray);

      margin-top:
        5px;

      font-size:
        14px;
    }

    .bio {
      margin-top:
        12px;

      line-height:
        1.4;

      color:
        #444;

      font-size:
        14px;
    }

    .skill-section {
      margin-top:
        14px;
    }

    .skill-section h4 {
      margin-bottom:
        7px;

      font-size:
        12px;

      color:
        #666;
    }

    .tag {
      display:
        inline-block;

      padding:
        7px 10px;

      border-radius:
        15px;

      margin:
        3px 2px;

      font-size:
        11px;
    }

    .teach {
      background:
        var(--primary-light);

      color:
        var(--primary);
    }

    .learn {
      background:
        var(--secondary-light);

      color:
        var(--secondary-dark);
    }


    /* =====================================================
       SWIPE BUTTONS
    ===================================================== */

    .buttons {
      display:
        flex;

      justify-content:
        center;

      gap:
        35px;

      padding:
        2px 0 25px;
    }

    .round-button {
      width:
        65px;

      height:
        65px;

      border-radius:
        50%;

      border:
        none;

      cursor:
        pointer;

      font-size:
        28px;

      background:
        white;

      box-shadow:
        0 5px 18px
        rgba(0, 0, 0, 0.15);

      transition:
        0.2s;
    }

    .round-button:hover {
      transform:
        scale(1.12);
    }

    #reject {
      color:
        #FF4F70;
    }

    #like {
      color:
        var(--primary);
    }


    /* =====================================================
       POPUPS
    ===================================================== */

    .popup {
      position:
        absolute;

      inset:
        0;

      background:
        linear-gradient(
          150deg,
          var(--primary),
          var(--dark)
        );

      display:
        none;

      align-items:
        center;

      justify-content:
        center;

      z-index:
        50;

      padding:
        28px;

      overflow-y:
        auto;
    }

    .popup-content {
      color:
        white;

      text-align:
        center;

      width:
        100%;
    }

    .popup-content h1 {
      font-size:
        36px;

      color:
        var(--secondary);

      margin-bottom:
        10px;
    }

    .popup-content p {
      line-height:
        1.5;

      opacity:
        0.9;
    }


    /* =====================================================
       SKILL EXCHANGE BOX
    ===================================================== */

    .exchange-box {
      margin:
        24px 0;

      background:
        rgba(
          255,
          255,
          255,
          0.12
        );

      border-radius:
        22px;

      padding:
        18px;

      text-align:
        left;
    }

    .exchange-person {
      padding:
        10px 0;
    }

    .exchange-person strong {
      display:
        block;

      margin-bottom:
        6px;

      color:
        var(--secondary);
    }

    .exchange-skill {
      background:
        white;

      color:
        var(--primary);

      padding:
        8px 11px;

      border-radius:
        15px;

      display:
        inline-block;

      font-weight:
        bold;

      font-size:
        13px;
    }

    .swap-arrow {
      text-align:
        center;

      font-size:
        27px;

      margin:
        4px;
    }


    /* =====================================================
       SESSION LENGTH
    ===================================================== */

    .session-title {
      margin-top:
        15px;

      font-size:
        14px;
    }

    .session-options {
      display:
        flex;

      gap:
        8px;

      justify-content:
        center;

      margin:
        15px 0;

      flex-wrap:
        wrap;
    }

    .session-button {
      border:
        2px solid
        rgba(
          255,
          255,
          255,
          0.35
        );

      background:
        transparent;

      color:
        white;

      border-radius:
        18px;

      padding:
        10px 13px;

      cursor:
        pointer;

      transition:
        0.2s;
    }

    .session-button:hover,
    .session-button.selected {
      background:
        var(--secondary);

      color:
        var(--dark);

      border-color:
        var(--secondary);
    }


    /* =====================================================
       NORMAL BUTTONS
    ===================================================== */

    .main-button {
      display:
        block;

      width:
        100%;

      margin-top:
        10px;

      padding:
        14px;

      border:
        none;

      border-radius:
        22px;

      font-weight:
        bold;

      font-size:
        15px;

      cursor:
        pointer;

      color:
        var(--dark);

      background:
        var(--secondary);
    }

    .main-button:hover {
      transform:
        scale(1.02);
    }

    .secondary-button {
      background:
        transparent;

      border:
        none;

      color:
        #dddddd;

      cursor:
        pointer;

      margin-top:
        15px;
    }


    /* =====================================================
       AVAILABILITY CALENDAR
    ===================================================== */

    .calendar-container {
      margin-top:
        20px;

      width:
        100%;
    }

    .calendar-title {
      font-size:
        14px;

      margin-bottom:
        14px;

      color:
        white;
    }

    .calendar-grid {
      display:
        grid;

      grid-template-columns:
        repeat(
          2,
          1fr
        );

      gap:
        10px;
    }

    .time-slot {
      padding:
        13px 8px;

      border-radius:
        15px;

      background:
        rgba(
          255,
          255,
          255,
          0.12
        );

      border:
        2px solid
        rgba(
          255,
          255,
          255,
          0.2
        );

      color:
        white;

      cursor:
        pointer;

      transition:
        0.2s;

      font-size:
        12px;
    }

    .time-slot:hover {
      background:
        var(--secondary);

      color:
        var(--dark);

      transform:
        scale(1.03);
    }

    .time-slot.selected {
      background:
        var(--secondary);

      color:
        var(--dark);

      border-color:
        white;

      font-weight:
        bold;
    }

    .selected-time {
      margin-top:
        16px;

      padding:
        12px;

      border-radius:
        15px;

      background:
        rgba(
          255,
          255,
          255,
          0.1
        );

      font-size:
        13px;
    }


    /* =====================================================
       CONFIRMATION
    ===================================================== */

    .confirmation-icon {
      font-size:
        70px;

      margin-bottom:
        20px;
    }

    .confirmation-card {
      background:
        rgba(
          255,
          255,
          255,
          0.12
        );

      margin-top:
        20px;

      border-radius:
        20px;

      padding:
        20px;

      line-height:
        1.8;
    }


    /* =====================================================
       MY SESSIONS
    ===================================================== */

    .sessions-list {
      margin-top:
        20px;

      display:
        flex;

      flex-direction:
        column;

      gap:
        12px;
    }

    .session-card {
      background:
        white;

      color:
        var(--dark);

      text-align:
        left;

      padding:
        16px;

      border-radius:
        18px;

      line-height:
        1.6;
    }

    .session-card h3 {
      color:
        var(--primary);

      margin-bottom:
        5px;
    }

    .session-empty {
      margin-top:
        30px;

      padding:
        25px;

      background:
        rgba(
          255,
          255,
          255,
          0.1
        );

      border-radius:
        20px;
    }


    /* =====================================================
       FLYING BEERS 🍺
    ===================================================== */

    .flying-beer {
      position:
        absolute;

      bottom:
        -80px;

      font-size:
        45px;

      pointer-events:
        none;

      z-index:
        999;

      animation:
        beerFly
        2.5s
        ease-out
        forwards;
    }

    @keyframes beerFly {

      0% {
        transform:
          translateY(0)
          rotate(0deg)
          scale(0.5);

        opacity:
          0;
      }

      20% {
        opacity:
          1;
      }

      100% {
        transform:
          translateY(-900px)
          rotate(720deg)
          scale(1.4);

        opacity:
          0;
      }

    }


    /* =====================================================
       END SCREEN
    ===================================================== */

    .empty {
      height:
        470px;

      display:
        flex;

      justify-content:
        center;

      align-items:
        center;

      text-align:
        center;

      padding:
        30px;

      color:
        var(--gray);
    }

  </style>
</head>


