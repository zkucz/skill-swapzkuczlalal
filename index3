  ===================================================== */

  function animateCard(
    direction
  ) {

    const card =
      document.querySelector(
        ".card"
      );


    if (!card) {

      currentProfile++;

      showProfile();

      return;

    }


    if (
      direction ===
      "left"
    ) {

      card.style.transform =
        "translateX(-450px) rotate(-20deg)";

    }

    else {

      card.style.transform =
        "translateX(450px) rotate(20deg)";

    }


    card.style.opacity =
      "0";


    setTimeout(

      () => {

        currentProfile++;

        showProfile();

      },

      300

    );

  }



