  /* =====================================================
     FIND SKILL EXCHANGE
  ===================================================== */

  function findSkillExchange(
    person
  ) {

    const theyCanTeachYou =
      person.canTeach.filter(
        skill =>
          currentUser
            .wantsToLearn
            .includes(skill)
      );


    const youCanTeachThem =
      currentUser.canTeach.filter(
        skill =>
          person
            .wantsToLearn
            .includes(skill)
      );


    return {

      theyCanTeachYou,

      youCanTeachThem

    };

  }



  /* =====================================================
     CALCULATE MATCH SCORE
  ===================================================== */

  function calculateMatch(
    person
  ) {

    const exchange =
      findSkillExchange(
        person
      );


    const incoming =
      exchange
        .theyCanTeachYou
        .length;


    const outgoing =
      exchange
        .youCanTeachThem
        .length;


    if (
      incoming > 0 &&
      outgoing > 0
    ) {

      return Math.min(
        98,

        82 +
        incoming * 5 +
        outgoing * 4
      );

    }


    if (
      incoming > 0 ||
      outgoing > 0
    ) {

      return (
        63 +
        Math.max(
          incoming,
          outgoing
        ) * 5
      );

    }


    return 31;

  }



