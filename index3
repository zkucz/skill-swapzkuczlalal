  <!-- =====================================================
       PROFILE
  ====================================================== -->

  <div class="card-area">

    <div id="card"></div>

  </div>



  <!-- =====================================================
       SWIPE BUTTONS
  ====================================================== -->

  <div class="buttons">

    <button
      class="round-button"
      id="reject"
    >
      ✕
    </button>


    <button
      class="round-button"
      id="like"
    >
      ♥
    </button>

  </div>



  <!-- =====================================================
       MATCH POPUP
  ====================================================== -->

  <div
    class="popup"
    id="matchPopup"
  >

    <div class="popup-content">

      <h1>
        It's a Skill Match! 🎉
      </h1>


      <p id="matchIntro"></p>


      <div class="exchange-box">


        <div class="exchange-person">

          <strong id="otherPersonLabel">
            They teach you:
          </strong>

          <span
            class="exchange-skill"
            id="theyTeach"
          >
          </span>

        </div>


        <div class="swap-arrow">
          ⇅
        </div>


        <div class="exchange-person">

          <strong>
            You teach them:
          </strong>

          <span
            class="exchange-skill"
            id="youTeach"
          >
          </span>

        </div>

      </div>



      <div class="session-title">

        How long should your SkillSwap be?

      </div>


      <div class="session-options">

        <button
          class="session-button selected"
          onclick="
            chooseSession(
              this,
              '30 min ↔ 30 min'
            )
          "
        >
          30 ↔ 30
        </button>


        <button
          class="session-button"
          onclick="
            chooseSession(
              this,
              '45 min ↔ 45 min'
            )
          "
        >
          45 ↔ 45
        </button>


        <button
          class="session-button"
          onclick="
            chooseSession(
              this,
              '60 min ↔ 60 min'
            )
          "
        >
          60 ↔ 60
        </button>

      </div>


      <button
        class="main-button"
        onclick="openCalendar()"
      >
        📅 See Available Times
      </button>


      <button
        class="secondary-button"
        onclick="closeMatch()"
      >
        Keep Swiping
      </button>

    </div>

  </div>



  <!-- =====================================================
       CALENDAR
  ====================================================== -->

  <div
    class="popup"
    id="calendarPopup"
  >

    <div class="popup-content">

      <h1>
        Find a Time 📅
      </h1>


      <p id="calendarPerson"></p>


      <div class="calendar-container">

        <div class="calendar-title">

          Available SkillSwap sessions:

        </div>


        <div
          class="calendar-grid"
          id="calendarGrid"
        >
        </div>


        <div
          class="selected-time"
          id="selectedTimeDisplay"
        >
          No time selected yet 👀
        </div>

      </div>


      <button
        class="main-button"
        onclick="confirmSelectedTime()"
      >
        Confirm Session 🚀
      </button>


      <button
        class="secondary-button"
        onclick="closeCalendar()"
      >
        Go Back
      </button>

    </div>

  </div>



  <!-- =====================================================
       CONFIRMATION
  ====================================================== -->

  <div
    class="popup"
    id="confirmationPopup"
  >

    <div class="popup-content">


      <div class="confirmation-icon">
        🍻
      </div>


      <h1>
        Session Planned!
      </h1>


      <p>
        Congratulations. You successfully
        used your social skills.
      </p>


      <div
        class="confirmation-card"
        id="confirmationDetails"
      >
      </div>


      <button
        class="main-button"
        onclick="finishSession()"
      >
        Keep Swiping 💙
      </button>


      <button
        class="secondary-button"
        onclick="openMySessionsFromConfirmation()"
      >
        View My Sessions
      </button>

    </div>

  </div>



  <!-- =====================================================
       MY SESSIONS
  ====================================================== -->

  <div
    class="popup"
    id="sessionsPopup"
  >

    <div class="popup-content">

      <h1>
        My SkillSwaps 📚
      </h1>


      <p>
        Your upcoming learning sessions.
      </p>


      <div
        class="sessions-list"
        id="sessionsList"
      >
      </div>


      <button
        class="main-button"
        onclick="closeMySessions()"
      >
        Back to Swiping
      </button>

    </div>

  </div>


</div>



